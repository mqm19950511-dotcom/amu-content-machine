# Copy to .env.local (gitignored) and fill in. Both keys are optional —
# each unlocks one capability; everything else works without them.

# TikHub (https://tikhub.io) — pay-as-you-go API used by the pullers
# (xhs_me / xhs_discover / xhs_creator / x_creator). ~a few cents per full onboarding.
TIKHUB_API_KEY=

# Mistral (https://console.mistral.ai) — only needed for voice input in the
# dashboard interview (serve.mjs forwards audio to Voxtral for transcription).
MISTRAL_API_KEY=

# DeepSeek (https://platform.deepseek.com) — powers the dashboard AI buttons:
# 生成草稿 / 按意见修改 / 评审团（serve.mjs → ai_draft / ai_revise / ai_council）。
# Pay-as-you-go; a full draft+council round costs a few cents RMB.
DEEPSEEK_API_KEY=

# Optional overrides: point at a different env file instead of .env.local
# TIKHUB_ENV_PATH=/path/to/env
# MISTRAL_ENV_PATH=/path/to/env
